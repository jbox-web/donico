#!/usr/bin/env bash
# Stand-in for git in the children of fleet.sh: no sweep ever reaches a forge or
# touches a copy. It appends its working directory and its arguments to the
# file named by ORACLE_GIT_LOG, prints one line naming what it was asked, and
# fails in the one repository named by ORACLE_GIT_FAIL, so that the failure
# line of a sweep and its status 1 are compared too.
#
# Runs on the system bash (3.2): the children's PATH has no Homebrew.

printf '%s\t%s\n' "${PWD}" "$*" >>"${ORACLE_GIT_LOG:-/dev/null}"
printf 'fake git %s in %s\n' "$*" "${PWD##*/}"
if [ -n "${ORACLE_GIT_FAIL:-}" ] && [ "${PWD##*/}" = "${ORACLE_GIT_FAIL}" ]; then
  printf 'fake git: failing in %s on purpose\n' "${PWD##*/}" >&2
  exit 1
fi
exit 0
