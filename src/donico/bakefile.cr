require "ecr"

require "./hcl"
require "./image"
require "./ruby_list"

module Donico
  # Writer of docker-bake.hcl. The template gives the layout of the gem's ERB
  # one, byte for byte, so the files committed in the image repositories do
  # not change when they are regenerated by this binary. The build and the
  # push target of a row are one block rendered twice: they only differ by
  # their name, their output and their tags, and two copies of the args and
  # secrets were free to drift apart.
  class Bakefile
    def self.render(images : Array(Image)) : String
      new(images).to_s
    end

    def initialize(@images : Array(Image))
    end

    ECR.def_to_s "#{__DIR__}/bakefile.ecr"

    private def secrets?(image : Image) : Bool
      !(image.entry.secret_envs.empty? && image.entry.secret_files.empty?)
    end
  end
end
